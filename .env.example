# Copy to .env and fill in:  cp .env.example .env
# Lines are KEY=value. Variables already exported in your shell override this file.

# --- Required ---------------------------------------------------------------

# Airbrake user auth token: airbrake.io -> your avatar -> Profile -> "Auth Token".
# Either paste it here, or point AIRBRAKE_KEY_FILE at a file that contains only the token.
AIRBRAKE_KEY=
# AIRBRAKE_KEY_FILE=~/.airbrake_key

# Projects to watch, comma separated: id or id:Display name.
# The id is the number in the project URL: https://airbrake.io/projects/<id>/groups
# Without a name, the project's name is fetched from Airbrake.
AIRBRAKE_PROJECTS=123456,234567:Payments API

# --- Optional ---------------------------------------------------------------

# Only notices whose context.environment is one of these are counted.
AIRBRAKE_ENVIRONMENTS=production,prod

# Regex for known/accepted errors, matched against "<ErrorType>: <message>".
# Matches are still shown, collapsed under "Known / ignored". Leave empty to ignore nothing.
AIRBRAKE_IGNORE=ECONNRESET|Network Error|^ConnectionError|timeout exceeded

# For flagged errors in a project, count distinct values of a notice param to tell
# "one client looping" from "everyone is hitting it". Format: project_id:param[:label],...
# e.g. 123456:deviceId:device -> "Spread across 14 devices" / "Single device".
# Falls back to context.hostname when the param is missing.
AIRBRAKE_BREAKDOWN=

# Where reports/ and reviewed.json live (default: next to check.py).
# Use a different dir per config file if you run several with --env.
# AIRBRAKE_DATA_DIR=~/airbrake-reports

# Port for `check.py --serve`.
AIRBRAKE_PORT=8787

# Detection tuning.
BASELINE_DAYS=30        # days before the window used as the "normal" rate
SPIKE_RATIO=3           # window daily avg must be >= this x baseline (and x last 7 days)
SPIKE_MIN_NOTICES=20    # ignore spikes with fewer notices than this in the window
TREND_DAYS=14           # days shown in each error's sparkline
